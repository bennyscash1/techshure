# Optional: endpoint that receives the contact form as JSON (e.g. Formspree / Make / n8n webhook).
# If empty, the form opens WhatsApp (or email) with the details pre-filled.
VITE_FORM_ENDPOINT=

# Server-side only (Vercel env vars, or .env.local for `npm run dev`). Never prefix these with VITE_.

# Website chat (Hezki). Google AI Studio API key. If empty, the chat shows a contact fallback.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (gemini-2.5-flash is no longer available to new keys).
GEMINI_MODEL=

# Contact form and chat leads are emailed through Gmail SMTP.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=
